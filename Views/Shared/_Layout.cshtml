<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Pilates Studio</title>

    <!-- Google Fonts + Material Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom Material Skin -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "admin-layout" : "public-layout")">

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- ════ ADMIN SIDEBAR LAYOUT ════ -->
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <span class="material-icons-round">self_improvement</span>
                <span class="brand-text">Pilates Studio</span>
            </div>
            <ul class="sidebar-nav">
                @if (User.IsInRole("Admin"))
                {
                        <li class="nav-label">PRINCIPALE</li>
                        <li>
                            <a asp-controller="Admin" asp-action="Dashboard"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                                <span class="material-icons-round">dashboard</span>
                                <span>Dashboard</span>
                            </a>
                        </li>
                }
                
                <li class="nav-label">ANAGRAFICHE</li>
                
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-controller="Clienti" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clienti" ? "active" : "")">
                            <span class="material-icons-round">group</span>
                            <span>Clienti</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Insegnanti" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Insegnanti" ? "active" : "")">
                            <span class="material-icons-round">school</span>
                            <span>Insegnanti</span>
                        </a>
                    </li>
                }
                <li>
                    <a asp-controller="Corsi" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Corsi" ? "active" : "")">
                        <span class="material-icons-round">event</span>
                        <span>Corsi</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Calendario" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Calendario" ? "active" : "")">
                        <span class="material-icons-round">calendar_month</span>
                        <span>Calendario</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-link disabled">
                        <span class="material-icons-round">card_membership</span>
                        <span>Abbonamenti <span class="badge-soon">Soon</span></span>
                    </a>
                </li>
                @if (User.IsInRole("Insegnante"))
                {
                    <li class="nav-label">IL MIO PORTALE</li>
                    <li>
                        <a asp-controller="PortaleInsegnante" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PortaleInsegnante" ? "active" : "")">
                            <span class="material-icons-round">home</span>
                            <span>Il mio portale</span>
                        </a>
                    </li>
                }
                <li class="nav-label">SISTEMA</li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link w-100 border-0 bg-transparent">
                            <span class="material-icons-round">logout</span>
                            <span>Esci</span>
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="page-content" class="flex-grow-1">
            <!-- Top Bar -->
            <header class="topbar">
                <button id="sidebarToggle" class="btn-icon">
                    <span class="material-icons-round">menu</span>
                </button>
                <div class="topbar-right">
                    <div class="user-chip">
                        <span class="material-icons-round">account_circle</span>
                        <span class="user-name">@User.Identity!.Name</span>
                    </div>
                </div>
            </header>

            <!-- Alerts -->
            <div class="px-4 pt-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2" role="alert">
                        <span class="material-icons-round fs-5">check_circle</span>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible d-flex align-items-center gap-2" role="alert">
                        <span class="material-icons-round fs-5">error</span>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>

            <!-- Main Content -->
            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <!-- ════ PUBLIC LAYOUT ════ -->
    <nav class="navbar navbar-expand-lg navbar-public sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="material-icons-round me-2">self_improvement</span>
                <strong>Pilates Studio</strong>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPublic">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navPublic">
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item">
                        <a class="btn btn-primary-brand btn-sm" asp-controller="Account" asp-action="Login">
                            <span class="material-icons-round me-1" style="font-size:16px">lock</span>Area Riservata
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-public">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2">
                        <span class="material-icons-round">self_improvement</span>
                        <strong>Pilates Studio</strong>
                    </div>
                    <p class="text-muted small mb-0 mt-1">Il tuo centro benessere di fiducia</p>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <p class="text-muted small mb-0">&copy; @DateTime.Now.Year Pilates Studio. Tutti i diritti riservati.</p>
                </div>
            </div>
        </div>
    </footer>
}

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
