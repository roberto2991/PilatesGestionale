@{
    Layout = "~/Views/Shared/_LayoutKiosk.cshtml";
    ViewData["Title"] = "Benvenuto – Studio Pilates";
}

@section Styles {
<style>
    .kiosk-welcome {
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(160deg, #f0edf5 0%, #e8e0f5 100%);
        text-align: center;
        padding: 40px 24px;
        gap: 0;
    }

    /* Logo / icon */
    .kiosk-logo {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, var(--clr-primary), var(--clr-primary-dark));
        border-radius: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 40px rgba(107,76,154,.35);
        margin-bottom: 32px;
    }
    .kiosk-logo .material-icons-round { font-size: 52px; color: #fff; }

    /* Studio name */
    .kiosk-studio-name {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--clr-primary);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    /* Main heading */
    .kiosk-headline {
        font-size: 2.4rem;
        font-weight: 700;
        color: #1a1a2e;
        line-height: 1.2;
        margin-bottom: 20px;
    }

    /* Subtext */
    .kiosk-subtext {
        font-size: 1.1rem;
        color: #7a6a95;
        max-width: 520px;
        line-height: 1.7;
        margin-bottom: 48px;
    }

    /* Indicatore di attesa */
    .kiosk-waiting {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #fff;
        border: 1.5px solid #e0d6f0;
        border-radius: 16px;
        padding: 16px 28px;
        box-shadow: 0 4px 20px rgba(107,76,154,.10);
    }
    .kiosk-waiting-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--clr-primary);
        animation: pulse-dot 1.6s ease-in-out infinite;
        flex-shrink: 0;
    }
    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: .4; transform: scale(.7); }
    }
    .kiosk-waiting-text {
        font-size: .95rem;
        color: #555;
        font-weight: 500;
    }

    /* Footer */
    .kiosk-footer {
        position: fixed;
        bottom: 20px;
        left: 0; right: 0;
        text-align: center;
        font-size: .75rem;
        color: #bbafd0;
        letter-spacing: .5px;
    }
</style>
}

<div class="kiosk-welcome">

    <div class="kiosk-logo">
        <span class="material-icons-round">self_improvement</span>
    </div>

    <div class="kiosk-studio-name">Studio Pilates</div>

    <h1 class="kiosk-headline">Benvenuto!</h1>

    <p class="kiosk-subtext">
        Il personale dello studio sta preparando il tuo documento di iscrizione.<br>
        Tra poco potrai leggerlo e firmarlo direttamente qui.
    </p>

    <div class="kiosk-waiting">
        <div class="kiosk-waiting-dot"></div>
        <div class="kiosk-waiting-text">In attesa del documento da firmare…</div>
    </div>

</div>

<div class="kiosk-footer">Studio Pilates &mdash; Firma digitale contratti</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // Polling ogni 3 secondi: quando arriva un clienteId, vai alla pagina di firma
    async function verificaStato() {
        try {
            const resp = await fetch('/Kiosk/Stato', { cache: 'no-store' });
            if (!resp.ok) return;
            const data = await resp.json();
            if (data.clienteId) {
                window.location.href = '/Kiosk/Firma/' + data.clienteId;
            }
        } catch (_) {
            // Ignora errori di rete, riprova al prossimo ciclo
        }
    }

    verificaStato();
    setInterval(verificaStato, 3000);
})();
</script>
}
