@model Cliente
@{
    ViewData["Title"] = "Nuovo Cliente";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nuovo Cliente</h1>
        <p class="page-subtitle">Inserisci i dati anagrafici del nuovo cliente</p>
    </div>
    <a asp-action="Index" class="btn-outline-brand">
        <span class="material-icons-round me-1" style="font-size:18px">arrow_back</span>
        Torna alla lista
    </a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- Dati Principali -->
        <div class="col-lg-8">
            <div class="card p-4">
                <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">person</span>
                    Dati Anagrafici
                </h6>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Mario"/>
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Cognome" class="form-label"></label>
                        <input asp-for="Cognome" class="form-control" placeholder="Rossi"/>
                        <span asp-validation-for="Cognome" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="mario.rossi@email.it"/>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="+39 333 123 4567"/>
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="DataNascita" class="form-label"></label>
                        <input asp-for="DataNascita" type="date" class="form-control"/>
                        <span asp-validation-for="DataNascita" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="CodiceFiscale" class="form-label"></label>
                        <input asp-for="CodiceFiscale" class="form-control" placeholder="RSSMRA80A01H501Z"
                               style="text-transform:uppercase"/>
                        <span asp-validation-for="CodiceFiscale" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card p-4 mt-4">
                <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">location_on</span>
                    Indirizzo
                </h6>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Indirizzo" class="form-label"></label>
                        <input asp-for="Indirizzo" class="form-control" placeholder="Via Roma, 1"/>
                        <span asp-validation-for="Indirizzo" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-8">
                        <label asp-for="Citta" class="form-label"></label>
                        <input asp-for="Citta" class="form-control" placeholder="Roma"/>
                        <span asp-validation-for="Citta" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Cap" class="form-label"></label>
                        <input asp-for="Cap" class="form-control" placeholder="00100"/>
                        <span asp-validation-for="Cap" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card p-4 mt-4">
                <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">notes</span>
                    Note
                </h6>
                <textarea asp-for="Note" class="form-control" rows="4"
                          placeholder="Informazioni aggiuntive, condizioni di salute, preferenze…"></textarea>
                <span asp-validation-for="Note" class="text-danger small"></span>
            </div>
        </div>

        <!-- Sidebar opzioni -->
        <div class="col-lg-4">
            <div class="card p-4">
                <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">settings</span>
                    Impostazioni
                </h6>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="Attivo" checked/>
                    <label class="form-check-label" asp-for="Attivo">Cliente Attivo</label>
                </div>
                <p class="text-muted small">Un cliente inattivo non apparirà nelle statistiche e nelle prenotazioni.</p>
            </div>

            <!-- Foto Profilo -->
            <div class="card p-4 mt-4">
                <h6 class="fw-700 mb-3 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">photo_camera</span>
                    Foto Profilo
                </h6>
                <div class="text-center mb-3">
                    <div id="fotoPreviewWrap" style="display:none">
                        <img id="fotoPreviewImg" src="#" alt="Anteprima"
                             style="width:96px;height:96px;object-fit:cover;border-radius:50%;border:3px solid var(--clr-primary);margin-bottom:8px"/>
                    </div>
                    <div id="fotoAvatarWrap">
                        <div class="avatar-initials mx-auto mb-2" style="width:96px;height:96px;font-size:2rem" id="previewAvatar">?</div>
                    </div>
                    <div class="fw-600" id="previewNome" style="font-weight:600">Nuovo Cliente</div>
                    <div class="text-muted small" id="previewEmail">–</div>
                </div>
                <label class="btn btn-outline-secondary w-100" style="cursor:pointer;border-radius:8px">
                    <span class="material-icons-round me-1" style="font-size:16px;vertical-align:middle">upload</span>
                    Carica immagine
                    <input type="file" name="foto" id="fotoInput" accept="image/*" style="display:none"/>
                </label>
                <div class="text-muted small mt-2 text-center">JPG, PNG, GIF o WebP · max 5 MB</div>
                <span class="text-danger small" id="fotoError"></span>
            </div>

            <!-- Azioni -->
            <div class="d-flex flex-column gap-2 mt-4">
                <button type="submit" class="btn-primary-brand justify-content-center" style="padding:12px">
                    <span class="material-icons-round me-2">save</span>Salva Cliente
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary text-center" style="padding:11px;border-radius:8px">
                    Annulla
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    // Live preview
    const nomeInput    = document.getElementById('Nome');
    const cognomeInput = document.getElementById('Cognome');
    const emailInput   = document.getElementById('Email');
    const prevAvatar   = document.getElementById('previewAvatar');
    const prevNome     = document.getElementById('previewNome');
    const prevEmail    = document.getElementById('previewEmail');

    function updatePreview() {
        const n = nomeInput.value.trim();
        const c = cognomeInput.value.trim();
        prevNome.textContent  = (n || c) ? `${n} ${c}`.trim() : 'Nuovo Cliente';
        prevAvatar.textContent = ((n ? n[0] : '') + (c ? c[0] : '')).toUpperCase() || '?';
        prevEmail.textContent  = emailInput.value.trim() || '–';
    }

    [nomeInput, cognomeInput, emailInput].forEach(el => el?.addEventListener('input', updatePreview));

    // Foto preview
    const fotoInput     = document.getElementById('fotoInput');
    const fotoPreviewWrap = document.getElementById('fotoPreviewWrap');
    const fotoPreviewImg  = document.getElementById('fotoPreviewImg');
    const fotoAvatarWrap  = document.getElementById('fotoAvatarWrap');
    const fotoError       = document.getElementById('fotoError');

    fotoInput.addEventListener('change', function () {
        fotoError.textContent = '';
        const file = this.files[0];
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) {
            fotoError.textContent = "L'immagine non può superare i 5 MB.";
            this.value = '';
            return;
        }
        const reader = new FileReader();
        reader.onload = e => {
            fotoPreviewImg.src = e.target.result;
            fotoPreviewWrap.style.display = 'block';
            fotoAvatarWrap.style.display  = 'none';
        };
        reader.readAsDataURL(file);
    });
</script>
}
