@model Cliente
@{
    ViewData["Title"] = $"Modifica – {Model.NomeCompleto}";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Modifica Cliente</h1>
        <p class="page-subtitle">@Model.NomeCompleto</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary d-flex align-items-center gap-1">
            <span class="material-icons-round" style="font-size:18px">visibility</span> Dettagli
        </a>
        <a asp-action="Index" class="btn-outline-brand">
            <span class="material-icons-round me-1" style="font-size:18px">arrow_back</span>Lista
        </a>
    </div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden"/>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card p-4">
                <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">person</span>
                    Dati Anagrafici
                </h6>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control"/>
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Cognome" class="form-label"></label>
                        <input asp-for="Cognome" class="form-control"/>
                        <span asp-validation-for="Cognome" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control"/>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control"/>
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="DataNascita" class="form-label"></label>
                        <input asp-for="DataNascita" type="date" class="form-control"/>
                        <span asp-validation-for="DataNascita" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="CodiceFiscale" class="form-label"></label>
                        <input asp-for="CodiceFiscale" class="form-control" style="text-transform:uppercase"/>
                        <span asp-validation-for="CodiceFiscale" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card p-4 mt-4">
                <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">location_on</span>Indirizzo
                </h6>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Indirizzo" class="form-label"></label>
                        <input asp-for="Indirizzo" class="form-control"/>
                        <span asp-validation-for="Indirizzo" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-8">
                        <label asp-for="Citta" class="form-label"></label>
                        <input asp-for="Citta" class="form-control"/>
                        <span asp-validation-for="Citta" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Cap" class="form-label"></label>
                        <input asp-for="Cap" class="form-control"/>
                        <span asp-validation-for="Cap" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card p-4 mt-4">
                <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">notes</span>Note
                </h6>
                <textarea asp-for="Note" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Note" class="text-danger small"></span>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card p-4">
                <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                    <span class="material-icons-round text-primary" style="font-size:20px">settings</span>Stato
                </h6>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" asp-for="Attivo"/>
                    <label class="form-check-label" asp-for="Attivo">Cliente Attivo</label>
                </div>
                <hr/>
                <div class="text-muted small">
                    <div>Iscritto il: <strong>@Model.DataIscrizione.ToString("dd/MM/yyyy")</strong></div>
                    <div class="mt-1">Ultimo aggiornamento: <strong>@Model.UltimoAggiornamento.ToString("dd/MM/yyyy HH:mm")</strong></div>
                </div>
            </div>

            <div class="d-flex flex-column gap-2 mt-4">
                <button type="submit" class="btn-primary-brand justify-content-center" style="padding:12px">
                    <span class="material-icons-round me-2">save</span>Salva Modifiche
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary text-center" style="padding:11px;border-radius:8px">Annulla</a>
            </div>
        </div>
    </div>
</form>
