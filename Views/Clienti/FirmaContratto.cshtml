@model PilatesStudio.Models.Cliente
@{
    Layout = "~/Views/Shared/_LayoutFirma.cshtml";
    ViewData["Title"] = $"Firma Documento – {Model.NomeCompleto}";
}

@section Styles {
<style>
    .firma-root {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    /* ── Topbar ─────────────────────────────────────────── */
    .firma-topbar {
        background: #fff;
        border-bottom: 1px solid #e0d6f0;
        padding: 10px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        gap: 12px;
        flex-wrap: wrap;
    }
    .firma-topbar-brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .firma-topbar-brand .brand-icon {
        width: 36px; height: 36px;
        background: var(--clr-primary);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        color: #fff;
    }
    .firma-topbar-title { font-size: .95rem; font-weight: 600; color: #2d2d2d; }
    .firma-topbar-subtitle { font-size: .75rem; color: #888; }

    /* ── Main area ─────────────────────────────────────── */
    .firma-main {
        flex: 1;
        display: flex;
        overflow: hidden;
        gap: 0;
    }

    /* PDF viewer (left) */
    .firma-pdf-panel {
        flex: 1 1 55%;
        background: #525659;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .firma-pdf-panel embed {
        flex: 1;
        width: 100%;
        border: none;
    }

    /* Signature panel (right) */
    .firma-sign-panel {
        flex: 0 0 380px;
        background: #fff;
        border-left: 1px solid #e0d6f0;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        padding: 24px 20px;
        gap: 16px;
    }

    .sign-section-title {
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--clr-primary);
        margin-bottom: 6px;
    }

    /* Canvas firma */
    .canvas-wrapper {
        position: relative;
        border: 2px dashed #cbbfdf;
        border-radius: 12px;
        background: #faf8ff;
        overflow: hidden;
        cursor: crosshair;
    }
    .canvas-wrapper canvas {
        display: block;
        width: 100%;
        touch-action: none;
    }
    .canvas-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #c0b0d8;
        pointer-events: none;
        transition: opacity .2s;
    }
    .canvas-placeholder .material-icons-round { font-size: 36px; }
    .canvas-placeholder span { font-size: .8rem; margin-top: 6px; }

    /* Stato firma */
    .firma-stato {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .8rem;
        padding: 8px 12px;
        border-radius: 8px;
        transition: all .3s;
    }
    .firma-stato.vuota { background: #fff3e0; color: #e65100; }
    .firma-stato.firmata { background: #e8f5e9; color: #2e7d32; }

    /* Bottoni */
    .btn-firma-primary {
        background: var(--clr-primary);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-size: .9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        cursor: pointer;
        transition: background .2s, transform .1s;
    }
    .btn-firma-primary:hover:not(:disabled) { background: var(--clr-primary-dark); }
    .btn-firma-primary:active:not(:disabled) { transform: scale(.98); }
    .btn-firma-primary:disabled { background: #ccc; cursor: not-allowed; }

    .btn-firma-outline {
        background: transparent;
        color: var(--clr-primary);
        border: 1.5px solid var(--clr-primary);
        border-radius: 10px;
        padding: 9px 16px;
        font-size: .85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: background .15s;
        width: 100%;
        justify-content: center;
    }
    .btn-firma-outline:hover { background: var(--clr-primary-light); }

    /* Anteprima firma salvata */
    .firma-preview-img {
        border: 1px solid #e0d6f0;
        border-radius: 8px;
        max-width: 100%;
        background: #faf8ff;
        padding: 4px;
    }

    /* Divider */
    .firma-divider { border: none; border-top: 1px solid #f0ebf8; margin: 0; }

    /* Spinner overlay */
    .spinner-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,.75);
        z-index: 999;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 12px;
    }
    .spinner-overlay.active { display: flex; }
    .spinner-overlay .spinner-border { color: var(--clr-primary); width: 2.5rem; height: 2.5rem; }
    .spinner-overlay p { color: var(--clr-primary); font-size: .9rem; font-weight: 500; }

    @@media (max-width: 768px) {
        .firma-main { flex-direction: column; }
        .firma-pdf-panel { flex: 1 1 50vh; }
        .firma-sign-panel { flex: 0 0 auto; border-left: none; border-top: 1px solid #e0d6f0; }
    }
</style>
}

<!-- Spinner di caricamento -->
<div class="spinner-overlay" id="spinnerOverlay">
    <div class="spinner-border" role="status"></div>
    <p>Salvataggio firma in corso…</p>
</div>

<div class="firma-root">

    <!-- Topbar -->
    <div class="firma-topbar">
        <div class="firma-topbar-brand">
            <div class="brand-icon">
                <span class="material-icons-round" style="font-size:20px">self_improvement</span>
            </div>
            <div>
                <div class="firma-topbar-title">Firma Documento di Iscrizione</div>
                <div class="firma-topbar-subtitle">@Model.NomeCompleto</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (!string.IsNullOrEmpty(Model.FirmaPath))
            {
                <span class="firma-stato firmata">
                    <span class="material-icons-round" style="font-size:16px">verified</span>
                    Documento già firmato
                </span>
            }
            <a href="@Url.Action("Details", "Clienti", new { id = Model.Id })"
               class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                <span class="material-icons-round" style="font-size:16px">arrow_back</span>
                Torna al profilo
            </a>
        </div>
    </div>

    <!-- Main -->
    <div class="firma-main">

        <!-- PDF viewer -->
        <div class="firma-pdf-panel">
            <embed src="@Model.DocumentoContrattoPath"
                   type="application/pdf"
                   id="pdfViewer" />
        </div>

        <!-- Pannello firma -->
        <div class="firma-sign-panel">

            <!-- Istruzioni -->
            <div>
                <div class="sign-section-title">Istruzioni</div>
                <ol class="small text-muted ps-3 mb-0" style="line-height:1.7">
                    <li>Leggi il documento a sinistra.</li>
                    <li>Disegna la tua firma nel riquadro sotto.</li>
                    <li>Clicca <strong>Salva e firma documento</strong>.</li>
                </ol>
            </div>

            <hr class="firma-divider" />

            <!-- Firma attuale (se presente) -->
            @if (!string.IsNullOrEmpty(Model.FirmaPath))
            {
                <div>
                    <div class="sign-section-title">Firma attuale</div>
                    <img src="@Model.FirmaPath" alt="Firma attuale" class="firma-preview-img" />
                    <div class="small text-muted mt-2">Puoi aggiornare la firma disegnandone una nuova sotto.</div>
                </div>
                <hr class="firma-divider" />
            }

            <!-- Canvas firma -->
            <div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="sign-section-title mb-0">La tua firma</div>
                    <button type="button" id="btnCancella"
                            class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                            style="font-size:.75rem;padding:4px 10px">
                        <span class="material-icons-round" style="font-size:14px">delete_outline</span>
                        Cancella
                    </button>
                </div>

                <div class="canvas-wrapper" id="canvasWrapper">
                    <canvas id="firmaCanvas" height="140"></canvas>
                    <div class="canvas-placeholder" id="canvasPlaceholder">
                        <span class="material-icons-round">draw</span>
                        <span>Disegna qui la tua firma</span>
                    </div>
                </div>

                <div class="firma-stato vuota mt-2" id="firmaStato">
                    <span class="material-icons-round" style="font-size:16px">edit_off</span>
                    <span id="firmaStatoTesto">Nessuna firma disegnata</span>
                </div>
            </div>

            <hr class="firma-divider" />

            <!-- Bottoni azione -->
            <div class="d-flex flex-column gap-2">
                <button type="button" id="btnSalvaFirma"
                        class="btn-firma-primary" disabled>
                    <span class="material-icons-round" style="font-size:20px">draw</span>
                    Salva e firma documento
                </button>
                <a href="@Url.Action("DownloadContratto", "Clienti", new { id = Model.Id })"
                   target="_blank"
                   class="btn-firma-outline">
                    <span class="material-icons-round" style="font-size:18px">download</span>
                    Scarica PDF attuale
                </a>
            </div>

            <!-- Info -->
            <div class="small text-muted" style="line-height:1.5;font-size:.72rem">
                <span class="material-icons-round" style="font-size:13px;vertical-align:middle">info</span>
                La firma verrà incorporata nel documento PDF e salvata nel profilo del cliente.
            </div>

        </div><!-- /firma-sign-panel -->
    </div><!-- /firma-main -->
</div><!-- /firma-root -->

<!-- Form nascosto per l'invio -->
<form id="firmaForm" method="post"
      action="@Url.Action("SalvaFirma", "Clienti", new { id = Model.Id })">
    @Html.AntiForgeryToken()
    <input type="hidden" name="signatureData" id="signatureDataInput" />
</form>

@section Scripts {
<!-- signature_pad (Szimek) via CDN -->
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.2.0/dist/signature_pad.umd.min.js"></script>
<script>
(function () {
    'use strict';

    const canvas      = document.getElementById('firmaCanvas');
    const wrapper     = document.getElementById('canvasWrapper');
    const placeholder = document.getElementById('canvasPlaceholder');
    const stato       = document.getElementById('firmaStato');
    const statoTesto  = document.getElementById('firmaStatoTesto');
    const btnCancella = document.getElementById('btnCancella');
    const btnSalva    = document.getElementById('btnSalvaFirma');
    const spinner     = document.getElementById('spinnerOverlay');
    const dataInput   = document.getElementById('signatureDataInput');

    // ── Inizializza SignaturePad ──────────────────────────
    function ridimensionaCanvas() {
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width  = wrapper.offsetWidth  * ratio;
        canvas.height = canvas.height        * ratio;   // height fissa in px nel DOM
        canvas.getContext('2d').scale(ratio, ratio);
        pad.clear();
    }

    const pad = new SignaturePad(canvas, {
        penColor: '#1a1a2e',
        minWidth: 1.2,
        maxWidth: 3,
        throttle: 8
    });

    ridimensionaCanvas();
    window.addEventListener('resize', ridimensionaCanvas);

    // ── Reazione agli eventi del pad ─────────────────────
    pad.addEventListener('beginStroke', () => {
        placeholder.style.opacity = '0';
    });

    pad.addEventListener('afterUpdateStroke', () => {
        if (!pad.isEmpty()) {
            aggiornaStatoFirmata();
        }
    });

    function aggiornaStatoFirmata() {
        stato.className = 'firma-stato firmata';
        statoTesto.textContent = 'Firma disegnata ✓';
        btnSalva.disabled = false;
    }

    // ── Cancella ─────────────────────────────────────────
    btnCancella.addEventListener('click', () => {
        pad.clear();
        placeholder.style.opacity = '1';
        stato.className = 'firma-stato vuota';
        statoTesto.textContent = 'Nessuna firma disegnata';
        btnSalva.disabled = true;
    });

    // ── Salva firma ──────────────────────────────────────
    btnSalva.addEventListener('click', async () => {
        if (pad.isEmpty()) return;

        spinner.classList.add('active');
        btnSalva.disabled = true;

        // Esporta come PNG base64
        const pngData = pad.toDataURL('image/png');
        dataInput.value = pngData;

        // Invia via fetch (AJAX)
        const form = document.getElementById('firmaForm');
        const formData = new FormData(form);

        try {
            const resp = await fetch(form.action, {
                method: 'POST',
                body: formData
            });
            const json = await resp.json();
            if (json.success && json.redirectUrl) {
                window.location.href = json.redirectUrl;
            } else {
                alert('Errore durante il salvataggio della firma. Riprova.');
                spinner.classList.remove('active');
                btnSalva.disabled = false;
            }
        } catch (e) {
            alert('Errore di rete. Riprova.');
            spinner.classList.remove('active');
            btnSalva.disabled = false;
        }
    });

})();
</script>
}
