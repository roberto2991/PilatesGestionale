@model Cliente
@{
    ViewData["Title"] = Model.NomeCompleto;
    var iniziali = (Model.Nome.Length > 0 ? Model.Nome[0].ToString() : "") +
                   (Model.Cognome.Length > 0 ? Model.Cognome[0].ToString() : "");
    var eta = Model.DataNascita.HasValue
        ? (int)((DateTime.Today - Model.DataNascita.Value).TotalDays / 365.25)
        : (int?)null;
    var kioskClienteId = ViewData["KioskClienteId"] as int?;
    var questoClienteNelKiosk = kioskClienteId == Model.Id;
    var altroClienteNelKiosk = kioskClienteId.HasValue && kioskClienteId != Model.Id;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Scheda Cliente</h1>
        <p class="page-subtitle">Dettaglio anagrafico completo</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary-brand">
            <span class="material-icons-round me-1" style="font-size:18px">edit</span>Modifica
        </a>
        <a asp-action="Index" class="btn-outline-brand">
            <span class="material-icons-round me-1" style="font-size:18px">arrow_back</span>Lista
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Colonna Sinistra: profilo -->
    <div class="col-lg-4">
        <div class="card p-4 text-center">
            @if (!string.IsNullOrEmpty(Model.FotoProfiloPath))
            {
                <img src="@Model.FotoProfiloPath" alt="Foto profilo"
                     class="mx-auto mb-3 d-block"
                     style="width:80px;height:80px;object-fit:cover;border-radius:50%;
                            border:3px solid var(--clr-primary)"/>
            }
            else
            {
                <div class="avatar-initials mx-auto mb-3"
                     style="width:80px;height:80px;font-size:1.8rem;
                            background:linear-gradient(135deg,var(--clr-primary),var(--clr-primary-dark));
                            color:#fff">
                    @iniziali.ToUpper()
                </div>
            }
            <h4 class="fw-700 mb-1" style="font-weight:700">@Model.NomeCompleto</h4>
            <div class="mb-3">
                <span class="badge-pill @(Model.Attivo ? "badge-active" : "badge-inactive")">
                    <span class="material-icons-round" style="font-size:12px">@(Model.Attivo ? "check_circle" : "cancel")</span>
                    @(Model.Attivo ? "Attivo" : "Inattivo")
                </span>
            </div>
            <hr/>
            <div class="d-flex flex-column gap-3 text-start">
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:36px;height:36px;border-radius:10px;background:var(--clr-primary-light);
                                    display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <span class="material-icons-round" style="font-size:18px;color:var(--clr-primary)">email</span>
                        </div>
                        <div>
                            <div style="font-size:.7rem;color:var(--clr-text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px">Email</div>
                            <div class="small fw-500">@Model.Email</div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Telefono))
                {
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:36px;height:36px;border-radius:10px;background:#e8f5e9;
                                    display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <span class="material-icons-round" style="font-size:18px;color:#2e7d32">phone</span>
                        </div>
                        <div>
                            <div style="font-size:.7rem;color:var(--clr-text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px">Telefono</div>
                            <div class="small fw-500">@Model.Telefono</div>
                        </div>
                    </div>
                }
                @if (eta.HasValue)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:36px;height:36px;border-radius:10px;background:#e3f2fd;
                                    display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <span class="material-icons-round" style="font-size:18px;color:#1565c0">cake</span>
                        </div>
                        <div>
                            <div style="font-size:.7rem;color:var(--clr-text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px">Data di Nascita</div>
                            <div class="small fw-500">@Model.DataNascita!.Value.ToString("dd/MM/yyyy") (@eta anni)</div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Citta))
                {
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:36px;height:36px;border-radius:10px;background:#fff3e0;
                                    display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <span class="material-icons-round" style="font-size:18px;color:#e65100">location_on</span>
                        </div>
                        <div>
                            <div style="font-size:.7rem;color:var(--clr-text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px">Indirizzo</div>
                            <div class="small fw-500">
                                @(!string.IsNullOrEmpty(Model.Indirizzo) ? Model.Indirizzo + ", " : "")@Model.Citta @Model.Cap
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Azioni Rapide -->
        <div class="card p-3 mt-4">
            <h6 class="fw-700 mb-3" style="font-weight:700;font-size:.85rem">Azioni Rapide</h6>
            <div class="d-flex flex-column gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-sm btn-outline-primary d-flex align-items-center gap-2">
                    <span class="material-icons-round" style="font-size:16px">edit</span>Modifica Anagrafica
                </a>
                <form asp-action="ToggleAttivo" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-sm @(Model.Attivo ? "btn-outline-warning" : "btn-outline-success") w-100 d-flex align-items-center gap-2">
                        <span class="material-icons-round" style="font-size:16px">@(Model.Attivo ? "pause_circle" : "play_circle")</span>
                        @(Model.Attivo ? "Disattiva Cliente" : "Riattiva Cliente")
                    </button>
                </form>
                <a asp-action="Delete" asp-route-id="@Model.Id"
                   class="btn btn-sm btn-outline-danger d-flex align-items-center gap-2">
                    <span class="material-icons-round" style="font-size:16px">delete</span>Elimina Cliente
                </a>
            </div>
        </div>

        <!-- Documento Contratto -->
        <div class="card p-3 mt-4">
            <h6 class="fw-700 mb-3 d-flex align-items-center gap-2" style="font-weight:700;font-size:.85rem">
                <span class="material-icons-round" style="font-size:18px;color:#6b4c9a">description</span>
                Documento di Iscrizione
            </h6>
            @if (!string.IsNullOrEmpty(Model.DocumentoContrattoPath))
            {
                <div class="d-flex flex-column gap-2">
                    <!-- Stato firma -->
                    @if (!string.IsNullOrEmpty(Model.FirmaPath))
                    {
                        <div class="d-flex align-items-center gap-2 px-2 py-1 rounded-2"
                             style="background:#e8f5e9;font-size:.75rem;color:#2e7d32">
                            <span class="material-icons-round" style="font-size:14px">verified</span>
                            Documento firmato digitalmente
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 px-2 py-1 rounded-2"
                             style="background:#fff3e0;font-size:.75rem;color:#e65100">
                            <span class="material-icons-round" style="font-size:14px">edit_off</span>
                            Firma digitale non ancora apposta
                        </div>
                    }

                    <!-- Bottone: Invia al Kiosk iPad -->
                    @if (questoClienteNelKiosk)
                    {
                        <!-- Questo cliente è già nel kiosk in attesa -->
                        <div class="d-flex align-items-center gap-2 px-2 py-1 rounded-2 mb-1"
                             style="background:#e3f2fd;font-size:.75rem;color:#1565c0">
                            <span class="material-icons-round" style="font-size:14px">tablet_mac</span>
                            In attesa di firma sul kiosk…
                        </div>
                        <form asp-action="AnnullaKiosk" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-outline-secondary w-100 d-flex align-items-center gap-2">
                                <span class="material-icons-round" style="font-size:16px">cancel</span>
                                Annulla sessione kiosk
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="InviaAlKiosk" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm w-100 d-flex align-items-center gap-2"
                                    style="background:#6b4c9a;color:#fff;border:none"
                                    @(altroClienteNelKiosk ? "disabled title=\"Il kiosk è occupato da un altro cliente\"" : "")>
                                <span class="material-icons-round" style="font-size:16px">tablet_mac</span>
                                @(string.IsNullOrEmpty(Model.FirmaPath) ? "Invia al Kiosk per firma" : "Aggiorna firma sul Kiosk")
                            </button>
                        </form>
                    }

                    <a asp-action="DownloadContratto" asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2">
                        <span class="material-icons-round" style="font-size:16px">download</span>Scarica PDF
                    </a>
                    <form asp-action="RigeneraContratto" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-sm btn-outline-secondary w-100 d-flex align-items-center gap-2"
                                onclick="return confirm('Rigenera il documento PDF con i dati attuali? La firma digitale verrà mantenuta.')">
                            <span class="material-icons-round" style="font-size:16px">refresh</span>Rigenera PDF
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="text-center py-2 text-muted mb-2">
                    <span class="material-icons-round d-block mb-1" style="font-size:28px;opacity:.3">description</span>
                    <div style="font-size:.8rem">Nessun documento generato</div>
                </div>
                <a asp-action="DownloadContratto" asp-route-id="@Model.Id"
                   class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2">
                    <span class="material-icons-round" style="font-size:16px">picture_as_pdf</span>Genera e Scarica
                </a>
            }
        </div>
    </div>

    <!-- Colonna Destra: dettagli e abbonamenti -->
    <div class="col-lg-8">
        <!-- Info completa -->
        <div class="card p-4 mb-4">
            <h6 class="fw-700 mb-4 d-flex align-items-center gap-2" style="font-weight:700">
                <span class="material-icons-round text-primary" style="font-size:20px">badge</span>
                Informazioni Anagrafiche
            </h6>
            <div class="row g-3">
                @{
                    void InfoRow(string label, string? value)
                    {
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3" style="background:var(--clr-bg)">
                                <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;
                                            letter-spacing:.6px;color:var(--clr-text-muted);margin-bottom:4px">@label</div>
                                <div class="fw-500 small">@(string.IsNullOrEmpty(value) ? "–" : value)</div>
                            </div>
                        </div>
                    }
                }
                @{ InfoRow("Nome", Model.Nome); }
                @{ InfoRow("Cognome", Model.Cognome); }
                @{ InfoRow("Email", Model.Email); }
                @{ InfoRow("Telefono", Model.Telefono); }
                @{ InfoRow("Data di Nascita", Model.DataNascita?.ToString("dd/MM/yyyy")); }
                @{ InfoRow("Codice Fiscale", Model.CodiceFiscale); }
                @{ InfoRow("Indirizzo", Model.Indirizzo); }
                @{ InfoRow("Città", Model.Citta); }
                @{ InfoRow("CAP", Model.Cap); }
                @{ InfoRow("Iscritto il", Model.DataIscrizione.ToString("dd/MM/yyyy HH:mm")); }
            </div>
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="mt-3 p-3 rounded-3" style="background:var(--clr-primary-light)">
                    <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;
                                color:var(--clr-primary);margin-bottom:6px">Note</div>
                    <p class="small mb-0" style="color:var(--clr-primary-dark)">@Model.Note</p>
                </div>
            }
        </div>

        <!-- Abbonamenti -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span class="d-flex align-items-center gap-2">
                    <span class="material-icons-round text-primary" style="font-size:20px">card_membership</span>
                    Abbonamenti (@Model.Abbonamenti.Count)
                </span>
                <button class="btn btn-sm btn-outline-secondary disabled" title="Prossimamente">
                    <span class="material-icons-round me-1" style="font-size:16px">add</span>Nuovo
                </button>
            </div>
            @if (Model.Abbonamenti.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Inizio</th>
                                <th>Scadenza</th>
                                <th>Prezzo</th>
                                <th>Stato</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Abbonamenti.OrderByDescending(x => x.DataInizio))
                            {
                                var isScaduto = a.DataScadenza < DateTime.UtcNow;
                                <tr>
                                    <td class="small fw-500">@a.Tipo</td>
                                    <td class="small text-muted">@a.DataInizio.ToString("dd/MM/yyyy")</td>
                                    <td class="small text-muted">@a.DataScadenza.ToString("dd/MM/yyyy")</td>
                                    <td class="small fw-500">€@a.Prezzo.ToString("N2")</td>
                                    <td>
                                        <span class="badge-pill @(isScaduto ? "badge-inactive" : "badge-active")">
                                            @(isScaduto ? "Scaduto" : "Attivo")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <span class="material-icons-round d-block mb-2" style="font-size:36px;opacity:.3">card_membership</span>
                    <div class="small">Nessun abbonamento registrato</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Toast notifica firma kiosk -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1100">
    <div id="toastFirmaOk" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <span class="material-icons-round" style="font-size:20px">verified</span>
                <span id="toastFirmaMessaggio">Contratto firmato digitalmente con successo!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // Mostra toast se si arriva con ?firmato=1 o ?aggiornato=1
    const params = new URLSearchParams(window.location.search);
    const toastEl = document.getElementById('toastFirmaOk');
    const toastMsg = document.getElementById('toastFirmaMessaggio');

    if (params.get('firmato') === '1') {
        toastMsg.textContent = 'Contratto firmato digitalmente con successo!';
        new bootstrap.Toast(toastEl, { delay: 6000 }).show();
        history.replaceState({}, '', window.location.pathname);
    } else if (params.get('aggiornato') === '1') {
        toastMsg.textContent = 'Firma aggiornata sul contratto con successo!';
        new bootstrap.Toast(toastEl, { delay: 6000 }).show();
        history.replaceState({}, '', window.location.pathname);
    }

    @if (questoClienteNelKiosk)
    {
        <text>
    // Questo cliente è nel kiosk in attesa: poll ogni 3s per rilevare la firma
    const clienteId = @Model.Id;
    const pollTimer = setInterval(async function () {
        try {
            const res = await fetch('/Kiosk/Stato');
            const data = await res.json();
            if (data.clienteId == null) {
                clearInterval(pollTimer);
                if (data.lastSignedClienteId === clienteId) {
                    const hadFirma = @(string.IsNullOrEmpty(Model.FirmaPath) ? "false" : "true");
                    window.location.href = window.location.pathname + (hadFirma ? '?aggiornato=1' : '?firmato=1');
                } else {
                    // Sessione annullata → semplice ricarica
                    window.location.reload();
                }
            }
        } catch (e) { /* ignora errori di rete transitori */ }
    }, 3000);
        </text>
    }
})();
</script>
}
