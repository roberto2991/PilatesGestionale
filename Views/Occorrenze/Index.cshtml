@model PilatesStudio.Models.ViewModels.OccorrenzeListViewModel
@using PilatesStudio.Models
@{
    ViewData["Title"] = $"Sessioni – {Model.Corso.Nome}";
    var oggi = DateTime.Now.Date;
}

@functions {
    string BadgeStato(StatoOccorrenza stato) => stato switch
    {
        StatoOccorrenza.Svolta => "bg-success-subtle text-success border border-success-subtle",
        StatoOccorrenza.Annullata => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        _ => "bg-primary-subtle text-primary border border-primary-subtle"
    };
}

<div class="page-header mb-4">
    <a asp-controller="Corsi" asp-action="Details" asp-route-id="@Model.Corso.Id" class="btn btn-outline-secondary btn-sm mb-3">
        <span class="material-icons-round me-1" style="font-size:16px">arrow_back</span>Torna al corso
    </a>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="page-title">
                <span class="material-icons-round me-2">calendar_month</span>Sessioni in calendario
            </h1>
            <p class="text-muted mb-0">@Model.Corso.Nome — @Model.NumeroIscritti iscritti</p>
        </div>
    </div>
</div>

<!-- Filtri -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="d-flex gap-3 align-items-end flex-wrap">
            <input type="hidden" name="corsoId" value="@Model.Corso.Id" />
            <div>
                <label class="form-label small">Stato</label>
                <select name="stato" class="form-select">
                    <option value="">Tutti</option>
                    @foreach (var s in Enum.GetValues<StatoOccorrenza>())
                    {
                        <option value="@s" selected="@(Model.Stato == s)">@s</option>
                    }
                </select>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="soloFuture" value="true"
                       id="soloFuture" checked="@Model.SoloFuture" />
                <label class="form-check-label small" for="soloFuture">Solo dalla data odierna</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-brand">
                    <span class="material-icons-round me-1" style="font-size:18px">filter_alt</span>Filtra
                </button>
                <a asp-action="Index" asp-route-corsoId="@Model.Corso.Id" class="btn btn-outline-secondary">
                    <span class="material-icons-round" style="font-size:18px">clear</span>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Occorrenze.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <span class="material-icons-round d-block mb-2" style="font-size:48px">event_busy</span>
                <p class="mb-0">Nessuna sessione trovata con i filtri selezionati.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Giorno</th>
                            <th>Orario</th>
                            <th class="text-center">Stato</th>
                            <th class="text-center">Presenze</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Occorrenze)
                        {
                            var o = r.Occorrenza;
                            <tr class="@(o.Annullata ? "opacity-75" : "")">
                                <td>
                                    <span class="fw-medium">@o.Data.ToString("dd/MM/yyyy")</span>
                                    @if (o.Data.Date == oggi)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle ms-1">Oggi</span>
                                    }
                                </td>
                                <td><small>@o.GiornoNome</small></td>
                                <td><small>@o.OrarioFormatted</small></td>
                                <td class="text-center">
                                    <span class="badge @BadgeStato(o.Stato)">@o.Stato</span>
                                </td>
                                <td class="text-center">
                                    @if (r.NumPresenzeRegistrate > 0)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                            @r.NumPresenti presenti
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Dettaglio" asp-route-id="@o.Id"
                                       class="btn btn-sm btn-outline-primary" title="Presenze / dettaglio">
                                        <span class="material-icons-round" style="font-size:16px">fact_check</span>
                                    </a>
                                    @if (!o.Annullata)
                                    {
                                        <form asp-action="Annulla" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@o.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Annulla sessione"
                                                    onclick="return confirm('Annullare la sessione del @o.Data.ToString("dd/MM/yyyy")? I dati restano salvati.')">
                                                <span class="material-icons-round" style="font-size:16px">event_busy</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Ripristina" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@o.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Ripristina sessione">
                                                <span class="material-icons-round" style="font-size:16px">restore</span>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<p class="text-center text-muted small mt-3">@Model.Occorrenze.Count sessioni</p>
