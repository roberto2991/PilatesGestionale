@{
    ViewData["Title"] = "Accesso Negato";
    Layout = null;
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>403 – Accesso Negato</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <style>
        body { min-height:100vh; display:flex; align-items:center; justify-content:center;
               background: linear-gradient(135deg,#1a1a2e,#16213e); }
        .err-card { background:#fff; border-radius:20px; padding:48px 44px; max-width:440px;
                    width:100%; text-align:center; box-shadow:0 24px 48px rgba(0,0,0,.25); }
        .err-icon { width:80px; height:80px; border-radius:50%; background:#fce4ec;
                    display:flex; align-items:center; justify-content:center; margin:0 auto 24px;
                    color:#c62828; font-size:40px; }
    </style>
</head>
<body>
<div class="err-card">
    <div class="err-icon"><span class="material-icons-round">lock</span></div>
    <h1 style="font-size:1.6rem;font-weight:800;margin-bottom:8px">Accesso Negato</h1>
    <p class="text-muted mb-4">Non hai i permessi necessari per accedere a questa pagina.</p>
    <a asp-controller="Home" asp-action="Index" class="btn-primary-brand w-100 justify-content-center" style="padding:12px">
        <span class="material-icons-round me-2">home</span>Torna alla Home
    </a>
</div>
</body>
</html>
