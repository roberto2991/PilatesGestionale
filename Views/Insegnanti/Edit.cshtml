@model PilatesStudio.Models.ViewModels.InsegnanteEditViewModel
@{
    ViewData["Title"] = "Modifica Insegnante";
}

<div class="page-header mb-4">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm mb-3">
        <span class="material-icons-round me-1" style="font-size:16px">arrow_back</span>Torna al dettaglio
    </a>
    <h1 class="page-title">
        <span class="material-icons-round me-2">edit</span>Modifica Insegnante
    </h1>
</div>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0 d-flex align-items-center gap-2">
                        <span class="material-icons-round">badge</span>Dati Anagrafici
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cognome" class="form-label"></label>
                            <input asp-for="Cognome" class="form-control" />
                            <span asp-validation-for="Cognome" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CodiceFiscale" class="form-label"></label>
                            <input asp-for="CodiceFiscale" class="form-control text-uppercase"
                                   maxlength="16" style="font-family:monospace" />
                            <span asp-validation-for="CodiceFiscale" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text">Se modificata, viene aggiornata anche l'utenza di accesso.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Indirizzo" class="form-label"></label>
                            <input asp-for="Indirizzo" class="form-control" />
                            <span asp-validation-for="Indirizzo" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0 d-flex align-items-center gap-2">
                        <span class="material-icons-round">work</span>Dati Professionali
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="TitoloDiStudio" class="form-label"></label>
                            <input asp-for="TitoloDiStudio" class="form-control" />
                            <span asp-validation-for="TitoloDiStudio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StatoContratto" class="form-label"></label>
                            <select asp-for="StatoContratto"
                                    asp-items="Html.GetEnumSelectList<PilatesStudio.Models.StatoContrattuale>()"
                                    class="form-select"></select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-brand">
                    <span class="material-icons-round me-1">save</span>Salva modifiche
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Annulla</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('CodiceFiscale')?.addEventListener('input', function () {
            this.value = this.value.toUpperCase();
        });
    </script>
}
