@model PilatesStudio.Models.ViewModels.InsegnanteCreateViewModel
@{
    ViewData["Title"] = "Nuova Insegnante";
}

<div class="page-header mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <span class="material-icons-round me-1" style="font-size:16px">arrow_back</span>Torna alla lista
    </a>
    <h1 class="page-title">
        <span class="material-icons-round me-2">person_add</span>Nuova Insegnante
    </h1>
    <p class="text-muted">
        Al salvataggio verrà inviata automaticamente un'email di attivazione all'indirizzo fornito.
    </p>
</div>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>

            <!-- Dati anagrafici -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0 d-flex align-items-center gap-2">
                        <span class="material-icons-round">badge</span>Dati Anagrafici
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" placeholder="Es. Maria" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cognome" class="form-label"></label>
                            <input asp-for="Cognome" class="form-control" placeholder="Es. Rossi" />
                            <span asp-validation-for="Cognome" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CodiceFiscale" class="form-label"></label>
                            <input asp-for="CodiceFiscale" class="form-control text-uppercase"
                                   placeholder="RSSMRA80A01H501U" maxlength="16"
                                   style="font-family:monospace" />
                            <span asp-validation-for="CodiceFiscale" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email"
                                   placeholder="insegnante@esempio.it" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text">A questo indirizzo verrà inviato il link di attivazione.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Indirizzo" class="form-label"></label>
                            <input asp-for="Indirizzo" class="form-control"
                                   placeholder="Via Roma 1, 20100 Milano" />
                            <span asp-validation-for="Indirizzo" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dati professionali -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0 d-flex align-items-center gap-2">
                        <span class="material-icons-round">work</span>Dati Professionali
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="TitoloDiStudio" class="form-label"></label>
                            <input asp-for="TitoloDiStudio" class="form-control"
                                   placeholder="Es. Laurea in Scienze Motorie" />
                            <span asp-validation-for="TitoloDiStudio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StatoContratto" class="form-label"></label>
                            <select asp-for="StatoContratto"
                                    asp-items="Html.GetEnumSelectList<PilatesStudio.Models.StatoContrattuale>()"
                                    class="form-select"></select>
                            <span asp-validation-for="StatoContratto" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Info email -->
            <div class="alert alert-info d-flex align-items-start gap-2 mb-4">
                <span class="material-icons-round mt-1" style="font-size:20px">info</span>
                <div>
                    <strong>Cosa succede al salvataggio?</strong>
                    <ul class="mb-0 mt-1">
                        <li>Viene creata un'utenza con ruolo <em>Insegnante</em></li>
                        <li>Viene inviata un'email con un link univoco valido <strong>72 ore</strong></li>
                        <li>Al primo click, l'insegnante imposta la propria password</li>
                        <li>Se l'email non arriva, puoi reinviare l'invito dalla pagina dettaglio</li>
                    </ul>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-brand">
                    <span class="material-icons-round me-1">save</span>Crea e invia invito
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Annulla</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Forza uppercase sul campo CF mentre si digita
        document.getElementById('CodiceFiscale')?.addEventListener('input', function () {
            this.value = this.value.toUpperCase();
        });
    </script>
}
