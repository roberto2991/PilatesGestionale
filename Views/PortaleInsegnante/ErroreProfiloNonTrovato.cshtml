@{
    ViewData["Title"] = "Profilo non trovato";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:60vh">
    <div class="text-center">
        <span class="material-icons-round text-danger d-block mb-2" style="font-size:56px">error_outline</span>
        <h3>Profilo insegnante non trovato</h3>
        <p class="text-muted">Il profilo associato al tuo account non è stato trovato. Contatta l'amministratore.</p>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">
                <span class="material-icons-round me-1">logout</span>Esci
            </button>
        </form>
    </div>
</div>
