@model PilatesStudio.Models.Insegnante
@{
    ViewData["Title"] = "Il mio Portale";
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <span class="material-icons-round me-2">home</span>Benvenuta, @Model.Nome!
    </h1>
    <p class="text-muted">Questa è la tua area personale nel gestionale di Studio Pilates.</p>
</div>

<div class="row g-4">
    <!-- Profilo -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <span class="material-icons-round">person</span>
                <h5 class="mb-0">Il mio profilo</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Nome completo</dt>
                    <dd class="col-sm-7">@Model.NomeCompleto</dd>

                    <dt class="col-sm-5 text-muted small">Email</dt>
                    <dd class="col-sm-7">@Model.Email</dd>

                    @if (!string.IsNullOrEmpty(Model.TitoloDiStudio))
                    {
                        <dt class="col-sm-5 text-muted small">Titolo di studio</dt>
                        <dd class="col-sm-7">@Model.TitoloDiStudio</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Indirizzo))
                    {
                        <dt class="col-sm-5 text-muted small">Indirizzo</dt>
                        <dd class="col-sm-7">@Model.Indirizzo</dd>
                    }

                    <dt class="col-sm-5 text-muted small">Stato contratto</dt>
                    <dd class="col-sm-7">
                        @{
                            var (cls, icon) = Model.StatoContratto switch
                            {
                                PilatesStudio.Models.StatoContrattuale.Attivo => ("success", "check_circle"),
                                PilatesStudio.Models.StatoContrattuale.Sospeso => ("warning", "pause_circle"),
                                PilatesStudio.Models.StatoContrattuale.Cessato => ("danger", "cancel"),
                                _ => ("secondary", "draft")
                            };
                        }
                        <span class="badge bg-@cls-subtle text-@cls border border-@cls-subtle d-inline-flex align-items-center gap-1">
                            <span class="material-icons-round" style="font-size:13px">@icon</span>@Model.StatoContratto
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Placeholder corsi -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <span class="material-icons-round">fitness_center</span>
                <h5 class="mb-0">I miei corsi</h5>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
                <span class="material-icons-round text-muted mb-2" style="font-size:48px">event_note</span>
                <p class="text-muted mb-1">I corsi assegnati appariranno qui.</p>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                    <span class="material-icons-round me-1" style="font-size:13px">schedule</span>In arrivo
                </span>
            </div>
        </div>
    </div>

    <!-- Placeholder materiali -->
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <span class="material-icons-round">menu_book</span>
                <h5 class="mb-0">Materiali Didattici</h5>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
                <span class="material-icons-round text-muted mb-2" style="font-size:48px">folder_open</span>
                <p class="text-muted mb-1">I materiali didattici assegnati appariranno qui.</p>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                    <span class="material-icons-round me-1" style="font-size:13px">schedule</span>In arrivo
                </span>
            </div>
        </div>
    </div>
</div>
